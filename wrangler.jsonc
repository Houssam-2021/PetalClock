{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petalclock-site",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./docs"
  },
  "routes": [
    {
      "pattern": "petalclock.houseli.site",
      "custom_domain": true
    }
  ]
}
